<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🦊 Мемори — Учим звук [С]</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Nunito', sans-serif;
    min-height: 100vh;
    background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 50%, #ff9a9e 100%);
    overflow-x: hidden;
    position: relative;
  }

  /* Фоновые пузырьки */
  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
      radial-gradient(circle at 10% 20%, rgba(255,255,255,0.3) 0%, transparent 50%),
      radial-gradient(circle at 90% 80%, rgba(255,255,255,0.2) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(255,255,255,0.1) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .game-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    position: relative;
    z-index: 1;
  }

  /* Шапка */
  .header {
    text-align: center;
    margin-bottom: 15px;
  }

  .header h1 {
    font-size: 2.2em;
    font-weight: 900;
    color: #fff;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.15);
    margin-bottom: 5px;
  }

  .header .subtitle {
    font-size: 1.1em;
    color: #fff;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.1);
    background: rgba(255,255,255,0.25);
    display: inline-block;
    padding: 5px 20px;
    border-radius: 20px;
    backdrop-filter: blur(5px);
  }

  /* Панель статистики */
  .stats-panel {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-bottom: 15px;
    flex-wrap: wrap;
  }

  .stat-box {
    background: rgba(255,255,255,0.9);
    border-radius: 16px;
    padding: 10px 22px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    min-width: 120px;
    backdrop-filter: blur(10px);
  }

  .stat-box .label {
    font-size: 0.8em;
    color: #888;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .stat-box .value {
    font-size: 1.8em;
    font-weight: 900;
    color: #e74c3c;
  }

  .stat-box .value.moves { color: #3498db; }
  .stat-box .value.pairs { color: #2ecc71; }
  .stat-box .value.timer { color: #9b59b6; }

  /* Кнопки */
  .btn {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: #fff;
    border: none;
    padding: 12px 28px;
    border-radius: 30px;
    font-size: 1em;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(245,87,108,0.4);
    transition: all 0.3s ease;
    font-family: 'Nunito', sans-serif;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245,87,108,0.5);
  }

  .btn:active { transform: translateY(0); }

  .btn-reset {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    box-shadow: 0 4px 15px rgba(79,172,254,0.4);
  }

  .btn-reset:hover {
    box-shadow: 0 6px 20px rgba(79,172,254,0.5);
  }

  /* Игровое поле */
  .game-board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    max-width: 700px;
    margin: 0 auto 20px;
    perspective: 1000px;
  }

  /* Карточка */
  .card {
    aspect-ratio: 1;
    cursor: pointer;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 16px;
  }

  .card.flipped {
    transform: rotateY(180deg);
  }

  .card.matched {
    transform: rotateY(180deg);
    animation: matchPulse 0.6s ease;
  }

  .card.matched .card-front {
    box-shadow: 0 0 20px rgba(46,204,113,0.6);
    border-color: #2ecc71;
  }

  .card.shake {
    animation: shake 0.5s ease;
  }

  @keyframes shake {
    0%, 100% { transform: rotateY(180deg) translateX(0); }
    25% { transform: rotateY(180deg) translateX(-8px); }
    75% { transform: rotateY(180deg) translateX(8px); }
  }

  @keyframes matchPulse {
    0% { transform: rotateY(180deg) scale(1); }
    50% { transform: rotateY(180deg) scale(1.08); }
    100% { transform: rotateY(180deg) scale(1); }
  }

  .card-face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .card-back {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    box-shadow: 0 4px 15px rgba(102,126,234,0.4);
    border: 3px solid rgba(255,255,255,0.3);
    z-index: 2;
  }

  .card-back::before {
    content: '🦊';
    font-size: 2.5em;
    opacity: 0.9;
  }

  .card-back::after {
    content: '';
    position: absolute;
    top: 8px; left: 8px; right: 8px; bottom: 8px;
    border: 2px dashed rgba(255,255,255,0.3);
    border-radius: 12px;
  }

  .card-front {
    background: #fff;
    transform: rotateY(180deg);
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    border: 3px solid #eee;
    flex-direction: column;
    padding: 8px;
  }

  .card-front img {
    width: 85%;
    height: 75%;
    object-fit: contain;
    border-radius: 10px;
  }

  .card-front .card-label {
    font-size: 0.85em;
    font-weight: 900;
    color: #555;
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-front .card-label .highlight {
    color: #e74c3c;
    font-size: 1.1em;
  }

  /* Лисичка-помощница */
  .fox-helper {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 120px;
    height: 120px;
    z-index: 100;
    cursor: pointer;
    transition: transform 0.3s ease;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.2));
  }

  .fox-helper:hover {
    transform: scale(1.1) rotate(-5deg);
  }

  .fox-helper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fox-bubble {
    position: fixed;
    bottom: 145px;
    right: 10px;
    background: #fff;
    border-radius: 20px;
    padding: 12px 18px;
    font-size: 0.95em;
    font-weight: 700;
    color: #555;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    max-width: 220px;
    z-index: 100;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease;
    pointer-events: none;
  }

  .fox-bubble::after {
    content: '';
    position: absolute;
    bottom: -10px;
    right: 30px;
    width: 0;
    height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-top: 12px solid #fff;
  }

  .fox-bubble.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* Модальное окно победы */
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
    backdrop-filter: blur(5px);
  }

  .modal-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  .modal {
    background: #fff;
    border-radius: 30px;
    padding: 40px;
    text-align: center;
    max-width: 450px;
    width: 90%;
    transform: scale(0.8);
    transition: transform 0.4s ease;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .modal-overlay.show .modal {
    transform: scale(1);
  }

  .modal .fox-win {
    font-size: 4em;
    margin-bottom: 10px;
    animation: bounce 1s ease infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  .modal h2 {
    font-size: 2em;
    color: #e74c3c;
    margin-bottom: 10px;
  }

  .modal p {
    font-size: 1.1em;
    color: #666;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .modal .stars {
    font-size: 2.5em;
    margin-bottom: 15px;
  }

  .modal .btn {
    font-size: 1.1em;
    padding: 14px 35px;
  }

  /* Конфетти */
  .confetti-container {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    z-index: 999;
    overflow: hidden;
  }

  .confetti {
    position: absolute;
    width: 10px;
    height: 10px;
    top: -10px;
    animation: confettiFall linear forwards;
  }

  @keyframes confettiFall {
    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
  }

  /* Адаптивность */
  @media (max-width: 600px) {
    .game-board {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .header h1 { font-size: 1.5em; }
    .stat-box { min-width: 90px; padding: 8px 14px; }
    .stat-box .value { font-size: 1.4em; }
    .fox-helper { width: 80px; height: 80px; bottom: 10px; right: 10px; }
    .fox-bubble { bottom: 95px; right: 5px; font-size: 0.8em; max-width: 180px; }
    .card-back::before { font-size: 1.8em; }
  }

  /* Звук С подсветка */
  .sound-hint {
    text-align: center;
    margin-bottom: 10px;
  }

  .sound-hint span {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: #fff;
    padding: 6px 20px;
    border-radius: 20px;
    font-weight: 900;
    font-size: 1.1em;
    display: inline-block;
    box-shadow: 0 3px 10px rgba(245,87,108,0.3);
  }
</style>
</head>
<body>

<div class="game-container">
  <div class="header">
    <h1>🦊 Мемори — Звук [С]</h1>
    <div class="subtitle">Найди все пары карточек!</div>
  </div>

  <div class="sound-hint">
    <span>🔊 Учим звук [С] — аи<span style="color:#ffeb3b">с</span>т, автобу<span style="color:#ffeb3b">с</span>, ча<span style="color:#ffeb3b">с</span>ы...</span>
  </div>

  <div class="stats-panel">
    <div class="stat-box">
      <div class="label">Ходы</div>
      <div class="value moves" id="moves">0</div>
    </div>
    <div class="stat-box">
      <div class="label">Пары</div>
      <div class="value pairs" id="pairs">0 / 12</div>
    </div>
    <div class="stat-box">
      <div class="label">Время</div>
      <div class="value timer" id="timer">0:00</div>
    </div>
    <button class="btn btn-reset" onclick="resetGame()">🔄 Заново</button>
  </div>

  <div class="game-board" id="gameBoard"></div>
</div>

<!-- Лисичка-помощница -->
<div class="fox-helper" id="foxHelper" onclick="foxSpeak()">
  <img src="fox.png" alt="Лисичка" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦊</text></svg>'">
</div>
<div class="fox-bubble" id="foxBubble">Привет! Я лисичка! Давай учить звук [С]! 🎉</div>

<!-- Модальное окно победы -->
<div class="modal-overlay" id="winModal">
  <div class="modal">
    <div class="fox-win">🦊</div>
    <h2>Поздравляем!</h2>
    <div class="stars" id="starsDisplay">⭐⭐⭐</div>
    <p id="winText">Ты нашёл все пары!<br>Отличная память!</p>
    <button class="btn" onclick="resetGame(); closeModal();">🔄 Играть ещё</button>
  </div>
</div>

<!-- Конфетти -->
<div class="confetti-container" id="confettiContainer"></div>

<script>
// ===== ДАННЫЕ ИГРЫ =====
const cardsData = [
  { id: 'aist',    name: 'Аист',    highlight: 'с',   img: 'aist.png' },
  { id: 'bus',     name: 'Автобус', highlight: 'с',   img: 'bus.png' },
  { id: 'busi',    name: 'Бусы',    highlight: 'с',   img: 'busi.png' },
  { id: 'chasi',   name: 'Часы',    highlight: 'с',   img: 'chasi.png' },
  { id: 'kaktus',  name: 'Кактус',  highlight: 'с',   img: 'kaktus.png' },
  { id: 'kapusta', name: 'Капуста', highlight: 'с',   img: 'kapusta.png' },
  { id: 'kokos',   name: 'Кокос',   highlight: 'с',   img: 'kokos.png' },
  { id: 'koleso',  name: 'Колесо',  highlight: 'с',   img: 'koleso.png' },
  { id: 'maska',   name: 'Маска',   highlight: 'с',   img: 'maska.png' },
  { id: 'noski',   name: 'Носки',   highlight: 'с',   img: 'noski.png' },
  { id: 'sok',     name: 'Сок',     highlight: 'С',   img: 'sok.png' },
  { id: 'sova',    name: 'Сова',    highlight: 'С',   img: 'sova.png' },
];

// ===== СОСТОЯНИЕ ИГРЫ =====
let cards = [];
let flippedCards = [];
let matchedPairs = 0;
let moves = 0;
let isLocked = false;
let timerInterval = null;
let seconds = 0;
let gameStarted = false;

// ===== ФРАЗЫ ЛИСИЧКИ =====
const foxPhrases = [
  "Привет! Я лисичка! Давай учить звук [С]! 🎉",
  "Ищи одинаковые карточки! 🦊",
  "Запоминай, где какая картинка! ",
  "Все слова содержат звук [С]! 🔊",
  "АиСТ, автобуС, чаСы — слышишь [С]? 👂",
  "Ты молодец! Продолжай! ",
  "Какая отличная память! ",
  "С-С-С — наш любимый звук! 😊",
];
let foxPhraseIndex = 0;

// ===== ИНИЦИАЛИЗАЦИЯ =====
function initGame() {
  // Создаём пары и перемешиваем
  const pairs = [...cardsData, ...cardsData];
  cards = shuffle(pairs);

  const board = document.getElementById('gameBoard');
  board.innerHTML = '';

  cards.forEach((card, index) => {
    const cardEl = document.createElement('div');
    cardEl.className = 'card';
    cardEl.dataset.index = index;
    cardEl.dataset.id = card.id;

    cardEl.innerHTML = `
      <div class="card-face card-back"></div>
      <div class="card-face card-front">
        <img src="${card.img}" alt="${card.name}" 
             onerror="this.style.display='none'; this.parentElement.querySelector('.card-label').style.fontSize='1.2em';">
        <div class="card-label">${formatName(card.name, card.highlight)}</div>
      </div>
    `;

    cardEl.addEventListener('click', () => flipCard(cardEl, index));
    board.appendChild(cardEl);
  });

  // Сброс статистики
  moves = 0;
  matchedPairs = 0;
  seconds = 0;
  gameStarted = false;
  flippedCards = [];
  isLocked = false;
  updateStats();
  clearInterval(timerInterval);
  document.getElementById('timer').textContent = '0:00';
}

function formatName(name, highlight) {
  const lower = name.toLowerCase();
  const idx = lower.indexOf(highlight.toLowerCase());
  if (idx === -1) return name;
  return name.slice(0, idx) + 
    `<span class="highlight">${name[idx]}</span>` + 
    name.slice(idx + 1);
}

function shuffle(array) {
  const arr = [...array];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// ===== ЛОГИКА ИГРЫ =====
function flipCard(cardEl, index) {
  if (isLocked) return;
  if (cardEl.classList.contains('flipped')) return;
  if (cardEl.classList.contains('matched')) return;
  if (flippedCards.length >= 2) return;

  // Запуск таймера
  if (!gameStarted) {
    gameStarted = true;
    startTimer();
    showFoxBubble("Отлично! Начинаем! 🎯");
  }

  cardEl.classList.add('flipped');
  flippedCards.push({ el: cardEl, index, id: cards[index].id });

  if (flippedCards.length === 2) {
    moves++;
    updateStats();
    checkMatch();
  }
}

function checkMatch() {
  isLocked = true;
  const [card1, card2] = flippedCards;

  if (card1.id === card2.id) {
    // Совпадение!
    setTimeout(() => {
      card1.el.classList.add('matched');
      card2.el.classList.add('matched');
      matchedPairs++;
      updateStats();
      flippedCards = [];
      isLocked = false;

      // Фраза лисички
      const matchPhrases = [
        "Молодец! Пара найдена! ",
        "Отлично! Так держать! ⭐",
        "Супер! Ещё одна пара! 🌟",
        "Замечательно! ",
      ];
      showFoxBubble(matchPhrases[Math.floor(Math.random() * matchPhrases.length)]);

      // Проверка победы
      if (matchedPairs === cardsData.length) {
        setTimeout(showWin, 600);
      }
    }, 500);
  } else {
    // Не совпали
    setTimeout(() => {
      card1.el.classList.add('shake');
      card2.el.classList.add('shake');
    }, 400);

    setTimeout(() => {
      card1.el.classList.remove('flipped', 'shake');
      card2.el.classList.remove('flipped', 'shake');
      flippedCards = [];
      isLocked = false;
    }, 1000);
  }
}

// ===== ТАЙМЕР =====
function startTimer() {
  timerInterval = setInterval(() => {
    seconds++;
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    document.getElementById('timer').textContent = 
      `${mins}:${secs.toString().padStart(2, '0')}`;
  }, 1000);
}

// ===== СТАТИСТИКА =====
function updateStats() {
  document.getElementById('moves').textContent = moves;
  document.getElementById('pairs').textContent = `${matchedPairs} / ${cardsData.length}`;
}

// ===== ПОБЕДА =====
function showWin() {
  clearInterval(timerInterval);

  // Звёзды в зависимости от ходов
  let stars = '⭐⭐⭐';
  if (moves > 18) stars = '⭐⭐';
  if (moves > 25) stars = '⭐';

  document.getElementById('starsDisplay').textContent = stars;
  document.getElementById('winText').innerHTML = 
    `Ты нашёл все 12 пар за <b>${moves}</b> ходов!<br>Время: <b>${document.getElementById('timer').textContent}</b><br> Лисичка гордится тобой!`;

  document.getElementById('winModal').classList.add('show');
  launchConfetti();
  showFoxBubble("Ура! Ты победил! 🎉");
}

function closeModal() {
  document.getElementById('winModal').classList.remove('show');
}

// ===== КОНФЕТТИ =====
function launchConfetti() {
  const container = document.getElementById('confettiContainer');
  container.innerHTML = '';
  const colors = ['#f5576c', '#4facfe', '#43e97b', '#fa709a', '#fee140', '#a18cd1', '#fbc2eb'];

  for (let i = 0; i < 80; i++) {
    const confetti = document.createElement('div');
    confetti.className = 'confetti';
    confetti.style.left = Math.random() * 100 + '%';
    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
    confetti.style.width = (Math.random() * 10 + 5) + 'px';
    confetti.style.height = (Math.random() * 10 + 5) + 'px';
    confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
    confetti.style.animationDuration = (Math.random() * 2 + 2) + 's';
    confetti.style.animationDelay = (Math.random() * 2) + 's';
    container.appendChild(confetti);
  }

  setTimeout(() => { container.innerHTML = ''; }, 5000);
}

// ===== ЛИСИЧКА =====
function showFoxBubble(text) {
  const bubble = document.getElementById('foxBubble');
  bubble.textContent = text;
  bubble.classList.add('show');
  setTimeout(() => bubble.classList.remove('show'), 3000);
}

function foxSpeak() {
  showFoxBubble(foxPhrases[foxPhraseIndex]);
  foxPhraseIndex = (foxPhraseIndex + 1) % foxPhrases.length;
}

// ===== СБРОС =====
function resetGame() {
  closeModal();
  document.getElementById('confettiContainer').innerHTML = '';
  initGame();
  showFoxBubble("Новая игра! Удачи! 🍀");
}

// ===== ЗАПУСК =====
initGame();

// Приветствие через секунду
setTimeout(() => showFoxBubble("Привет! Я лисичка! Давай учить звук [С]! 🎉"), 1000);
</script>

</body>
</html>
